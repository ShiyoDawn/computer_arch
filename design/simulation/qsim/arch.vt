module memsys_vlg_vec_tst();
// constants                                           
// general purpose registers
reg [7:0] A;
reg CLK;
reg [7:0] D;
reg R;
reg W;
// wires                                               
wire [7:0] mA;
wire [7:0] mD;

wire sampler;                             

// assign statements (if any)                          
memsys i1 (
// port map - connection between master ports and signals/registers   
	.A(A),
	.CLK(CLK),
	.D(D),
	.mA(mA),
	.mD(mD),
	.R(R),
	.W(W)
);
// A[ 7 ]
initial
begin
	A[7] = 1'b0;
end 
// A[ 6 ]
initial
begin
	A[6] = 1'b0;
	A[6] = #640000 1'b1;
end 
// A[ 5 ]
initial
begin
	A[5] = 1'b0;
	A[5] = #320000 1'b1;
	A[5] = #320000 1'b0;
	A[5] = #320000 1'b1;
end 
// A[ 4 ]
initial
begin
	A[4] = 1'b0;
	A[4] = #230000 1'b1;
	A[4] = #90000 1'b0;
	A[4] = #160000 1'b1;
	A[4] = #160000 1'b0;
	A[4] = #160000 1'b1;
	A[4] = #160000 1'b0;
end 
// A[ 3 ]
initial
begin
	A[3] = 1'b0;
	A[3] = #80000 1'b1;
	A[3] = #20000 1'b0;
	A[3] = #80000 1'b1;
	A[3] = #50000 1'b0;
	A[3] = #10000 1'b1;
	# 80000;
	repeat(4)
	begin
		A[3] = 1'b0;
		A[3] = #80000 1'b1;
		# 80000;
	end
	A[3] = 1'b0;
end 
// A[ 2 ]
initial
begin
	A[2] = 1'b0;
	A[2] = #40000 1'b1;
	A[2] = #40000 1'b0;
	A[2] = #60000 1'b1;
	A[2] = #40000 1'b0;
	A[2] = #40000 1'b1;
	A[2] = #20000 1'b0;
	A[2] = #40000 1'b1;
	# 40000;
	repeat(8)
	begin
		A[2] = 1'b0;
		A[2] = #40000 1'b1;
		# 40000;
	end
	A[2] = 1'b0;
end 
// A[ 1 ]
initial
begin
	repeat(2)
	begin
		A[1] = 1'b0;
		A[1] = #20000 1'b1;
		# 20000;
	end
	A[1] = 1'b0;
	A[1] = #40000 1'b1;
	# 20000;
	repeat(2)
	begin
		A[1] = 1'b0;
		A[1] = #20000 1'b1;
		# 20000;
	end
	A[1] = 1'b0;
	A[1] = #10000 1'b1;
	A[1] = #10000 1'b0;
	A[1] = #20000 1'b1;
	# 20000;
	repeat(18)
	begin
		A[1] = 1'b0;
		A[1] = #20000 1'b1;
		# 20000;
	end
end 
// A[ 0 ]
initial
begin
	repeat(5)
	begin
		A[0] = 1'b0;
		A[0] = #10000 1'b1;
		# 10000;
	end
	repeat(6)
	begin
		A[0] = 1'b0;
		A[0] = #10000 1'b1;
		# 10000;
	end
	A[0] = 1'b0;
	A[0] = #10000 1'b1;
	# 10000;
	repeat(38)
	begin
		A[0] = 1'b0;
		A[0] = #10000 1'b1;
		# 10000;
	end
end 

// CLK
always
begin
	CLK = 1'b0;
	CLK = #5000 1'b1;
	#5000;
end 
// D[ 7 ]
