initial 

begin 
$timeformat(-12,3," ps",6);
#1000000;
if (nummismatches > 0)
	$display ("%d mismatched vectors : Simulation failed !",nummismatches);
else
	$display ("Simulation passed !");
$finish;
end 
endmodule

module memtest_vlg_vec_tst();
// constants                                           
// general purpose registers
reg aSEL;
reg CLK;
reg CNT;
reg R;
reg RST;
reg W;
reg wMAR;
reg wMBR;
// wires                                               
wire [7:0] mA;
wire [7:0] MAR;
wire [7:0] MBR;
wire [7:0] PC;
wire [7:0] Q;

wire sampler;                             

// assign statements (if any)                          
memtest i1 (
// port map - connection between master ports and signals/registers   
	.aSEL(aSEL),
	.CLK(CLK),
	.CNT(CNT),
	.mA(mA),
	.MAR(MAR),
	.MBR(MBR),
	.PC(PC),
	.Q(Q),
	.R(R),
	.RST(RST),
	.W(W),
	.wMAR(wMAR),
	.wMBR(wMBR)
);

// aSEL
initial
begin
	aSEL = 1'b0;
	aSEL = #30000 1'b1;
	aSEL = #10000 1'b0;
	aSEL = #40000 1'b1;
	aSEL = #20000 1'b0;
end 

// CLK
always
begin
	CLK = 1'b0;
	CLK = #5000 1'b1;
	#5000;
end 

// CNT
initial
begin
	CNT = 1'b0;
	CNT = #50000 1'b1;
	CNT = #10000 1'b0;
end 

// R
initial
begin
	R = 1'b0;
	R = #10000 1'b1;
	R = #10000 1'b0;
	R = #10000 1'b1;
	R = #10000 1'b0;
	R = #20000 1'b1;
	R = #10000 1'b0;
	R = #20000 1'b1;
	R = #10000 1'b0;
end 

// W
initial
begin
	W = 1'b0;
	W = #80000 1'b1;
	W = #10000 1'b0;
end 

// wMAR
initial
begin
	wMAR = 1'b0;
	wMAR = #20000 1'b1;
	wMAR = #10000 1'b0;
	wMAR = #40000 1'b1;
	wMAR = #10000 1'b0;
end 

// wMBR
initial
begin
	wMBR = 1'b0;
	wMBR = #40000 1'b1;
	wMBR = #10000 1'b0;
end 

// RST
initial
begin
	RST = 1'b0;
	RST = #10000 1'b1;
end 

memtest_vlg_sample_tst tb_sample (
	.aSEL(aSEL),
	.CLK(CLK),
	.CNT(CNT),
	.R(R),
	.RST(RST),
	.W(W),
	.wMAR(wMAR),
	.wMBR(wMBR),
	.sampler_tx(sampler)
);

memtest_vlg_check_tst tb_out(
	.mA(mA),
	.MAR(MAR),
	.MBR(MBR),
	.PC(PC),
	.Q(Q),
	.sampler_rx(sampler)
);
endmodule

