`timescale 1 ps/ 1 ps
module memsys_vlg_sample_tst(
	A,
	CLK,
	D,
	R,
	W,
	sampler_tx
);
input [7:0] A;
input  CLK;
input [7:0] D;
input  R;
input  W;
output sampler_tx;

reg sample;
time current_time;
always @(A or CLK or D or R or W)
                                                                                
begin                                                 
 if ($realtime > 0)                                   
 begin                                                
	if ($realtime == 0 || $realtime != current_time)  
	begin									          
		if (sample === 1'bx)                          
			sample = 0;                               
		else                                          
			sample = ~sample;                         
	end										          
	current_time = $realtime;					      
 end                                                  
end                                                   

assign sampler_tx = sample;
endmodule

