`timescale 1 ps/ 1 ps
module memtest_vlg_sample_tst(
	aSEL,
	CLK,
	CNT,
	R,
	RST,
	W,
	wMAR,
	wMBR,
	sampler_tx
);
input  aSEL;
input  CLK;
input  CNT;
input  R;
input  RST;
input  W;
input  wMAR;
input  wMBR;
output sampler_tx;

reg sample;
time current_time;
always @(aSEL or CLK or CNT or R or RST or W or wMAR or wMBR)
                                                                                
begin                                                 
 if ($realtime > 0)                                   
 begin                                                
	if ($realtime == 0 || $realtime != current_time)  
	begin									          
		if (sample === 1'bx)                          
			sample = 0;                               
		else                                          
			sample = ~sample;                         
	end										          
	current_time = $realtime;					      
 end                                                  
end                                                   

assign sampler_tx = sample;
endmodule

